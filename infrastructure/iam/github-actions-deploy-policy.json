{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListReleaseBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_VOKIE_BUCKET"
    },
    {
      "Sid": "WriteReleaseArtifactsAndWebsite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_VOKIE_BUCKET/*"
    },
    {
      "Sid": "ReadPrivateBundledModelArchive",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_VOKIE_MODELS_BUCKET/models/*"
    },
    {
      "Sid": "InvalidateCloudFront",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation"],
      "Resource": "arn:aws:cloudfront::REPLACE_AWS_ACCOUNT_ID:distribution/REPLACE_DISTRIBUTION_ID"
    },
    {
      "Sid": "ReadCloudFrontDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:GetDistribution", "cloudfront:GetInvalidation", "cloudfront:ListDistributions"],
      "Resource": "*"
    }
  ]
}
